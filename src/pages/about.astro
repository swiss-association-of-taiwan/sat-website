---
import { getEntry, getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import ImageFigure from "../components/ImageFigure.astro";
import DocumentCard from "../components/DocumentCard.astro";
import TocNav from "../components/TocNav.astro";
import { parseArticleBody } from "../lib/articleBody";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing content/pages/about.md");
const { title, subtitle, intro, heroImage, toc, archiveFigures, documents, definitionRows, articlesLink, closing } =
  page.data;

const blocks = parseArticleBody(page.body ?? "");
const figureByKey = new Map((archiveFigures ?? []).map((f) => [f.key, f]));
const documentByKey = new Map((documents ?? []).map((d) => [d.key, d]));

const committee = (await getCollection("committee")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={title} current="about">
  <PageHeader title={title} subtitle={subtitle} intro={intro} />

  {
    heroImage && (
      <div class="max-w-content mx-auto px-5 lg:px-16 pb-12 md:pb-22">
        <ImageFigure src={heroImage.src} alt={heroImage.alt} caption={heroImage.caption} ratio="21:9" />
      </div>
    )
  }

  <div class="border-t border-ink bg-canvas">
    <div class="max-w-content mx-auto px-5 lg:px-16 pt-12 md:pt-20 pb-16 md:pb-section">
      <div class="grid grid-cols-1 md:grid-cols-[220px_minmax(0,1fr)] gap-8 md:gap-16 items-start">
        <TocNav items={toc ?? []} />

        <div>
          <div id="how-it-started" class="article-body">
            {
              blocks.map((block) => {
                if (block.kind === "html") return <Fragment set:html={block.html} />;

                if (block.kind === "figureGroup") {
                  const figures = block.keys.map((k) => figureByKey.get(k)).filter((f) => f !== undefined);
                  return (
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-xl !mt-12">
                      {figures.map((fig) => (
                        <ImageFigure src={fig.src} alt={fig.alt} caption={fig.caption} ratio="3:2" grayscale />
                      ))}
                    </div>
                  );
                }

                if (block.kind === "documentGroup") {
                  const docs = block.keys.map((k) => documentByKey.get(k)).filter((d) => d !== undefined);
                  return (
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-lg !mt-10">
                      {docs.map((doc) => (
                        <DocumentCard href={doc.href} label={doc.label} title={doc.title} description={doc.description} />
                      ))}
                    </div>
                  );
                }

                if (block.kind === "definitionRows") {
                  return (
                    <div class="!mt-12 border-t border-ink">
                      {(definitionRows ?? []).map((row) => (
                        <div class="flex flex-wrap gap-x-lg gap-y-xs py-lg border-b border-rule">
                          <div class="basis-[132px] shrink-0 text-label text-ink pt-1">{row.label}</div>
                          <div class="flex-1 min-w-[200px] text-body-md text-body max-w-[68ch]">{row.value}</div>
                        </div>
                      ))}
                    </div>
                  );
                }

                if (block.kind === "emphasis") {
                  return <p class="text-display-quiet text-ink !mt-10 max-w-[26ch]">{block.text}</p>;
                }

                return null;
              })
            }
          </div>

          <section id="committee" class="mt-12 md:mt-16 border-t border-ink pt-10 md:pt-14">
            <h2 class="text-heading-lg text-ink max-w-[26ch]">Our Committee</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-12 mt-12">
              {
                committee.map((member) => (
                  <div>
                    {member.data.photo ? (
                      <img
                        src={member.data.photo}
                        alt={member.data.name}
                        class="w-full aspect-square object-cover"
                      />
                    ) : (
                      <div class="w-full aspect-square bg-canvas-soft border border-rule flex items-end p-sm">
                        <span class="text-label !text-[12px] text-mute">{member.data.role}</span>
                      </div>
                    )}
                    <div class="border-t border-ink mt-md pt-md">
                      <div class="text-label text-red-ink">{member.data.role}</div>
                      <div class="text-heading-sm text-ink mt-xs">{member.data.name}</div>
                      <p class="text-body-sm text-body mt-xs">{member.data.blurb}</p>
                      {member.data.email && (
                        <a href={`mailto:${member.data.email}`} class="inline-block mt-sm text-body-sm text-red-ink break-words hover:text-ink">
                          {member.data.email}
                        </a>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>

            <p class="text-body-md text-body mt-12 pt-lg border-t border-ink max-w-[68ch]">
              Want to know more about how SAT is structured and governed? You can read our{" "}
              {articlesLink ? (
                <a href={articlesLink} target="_blank" rel="noopener" class="link-inline">
                  Association Articles
                </a>
              ) : (
                "Association Articles"
              )}{" "}
              here.
            </p>
          </section>
        </div>
      </div>
    </div>
  </div>

  {
    closing && (
      <Section background="canvas-soft" borderTop>
        <h2 class="text-heading-lg text-ink max-w-[24ch]">{closing.title}</h2>
        <p class="text-body-lead text-body mt-lg max-w-[68ch]">{closing.body}</p>
        <div class="flex flex-wrap gap-md mt-10">
          <a href={closing.primaryHref} class="inline-flex items-center bg-red text-on-red text-label px-lg py-md min-h-11 hover:bg-red-ink">
            {closing.primaryLabel}
          </a>
          <a href={closing.secondaryHref} class="inline-flex items-center bg-canvas-soft text-ink border border-ink text-label px-lg py-md min-h-11 hover:bg-ink hover:text-on-dark">
            {closing.secondaryLabel}
          </a>
        </div>
      </Section>
    )
  }
</Layout>
