---
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/noto-sans-tc/400.css";
import "@fontsource/noto-sans-tc/700.css";
import "../styles/global.css";
// ?url gives the same hashed /_astro/ URL the fontsource CSS above resolves to,
// so the preloads below hit the browser's cache instead of fetching twice.
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import inter800 from "@fontsource/inter/files/inter-latin-800-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { NavKey } from "../lib/nav";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  current: NavKey;
}

const { title, current } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("/images/logo-v4.png")} as="image" fetchpriority="high" />
    <link rel="preload" href={withBase("/images/sat-association-mark.svg")} as="image" />
    <slot name="head" />
    <!-- Sets the header's compact state before first paint. scrollY is usually
         still 0 here on a reload (the browser restores scroll later), so for
         reload/back-forward it falls back to the state Header.astro saved. -->
    <script is:inline>
      (function () {
        try {
          var c = window.scrollY > 180;
          var nav = performance.getEntriesByType("navigation")[0];
          var t = nav && nav.type;
          if (!c && (t === "reload" || t === "back_forward") && sessionStorage.getItem("sat-header-compact:" + location.pathname) === "1") c = true;
          if (c) document.documentElement.classList.add("header-compact");
        } catch (e) {}
      })();
    </script>
    <title>{title} · Swiss Association of Taiwan</title>
  </head>
  <body class="overflow-x-hidden">
    <Header current={current} />
    <slot />
    <Footer />
    <!-- EmailOctopus signup form (handoff/CHANGES-2026-09-23.md). Its script pulls
         in reCAPTCHA and a Google Fonts stylesheet, which kept the browser
         "waiting for www.google.com" during first paint. So it's injected once the
         page has loaded and the browser is idle — still appended at the end of
         <body>, where the static tag sat, and with the same data-form attribute
         the script looks for. -->
    <script is:inline>
      (function () {
        function add() {
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://eocampaign1.com/form/564a6662-2f1f-11f1-b9df-0b322fe22b99.js";
          s.setAttribute("data-form", "564a6662-2f1f-11f1-b9df-0b322fe22b99");
          document.body.appendChild(s);
        }
        function schedule() {
          if ("requestIdleCallback" in window) requestIdleCallback(add, { timeout: 3000 });
          else setTimeout(add, 1500);
        }
        if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule);
      })();
    </script>
  </body>
</html>
