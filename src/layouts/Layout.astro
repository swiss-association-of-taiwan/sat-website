---
import "@fontsource/inter/latin-300.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/inter/latin-800.css";
import "../styles/global.css";
// ?url gives the same hashed /_astro/ URL the fontsource CSS above resolves to,
// so the preloads below hit the browser's cache instead of fetching twice.
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import inter800 from "@fontsource/inter/files/inter-latin-800-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { NavKey } from "../lib/nav";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  current: NavKey;
}

const { title, current } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("/images/sat-lockup.svg")} as="image" fetchpriority="high" />
    <slot name="head" />
    <!-- Sets the header's compact state before first paint. It must not read
         layout (scrollY counts — it forces a reflow), so it only uses the state
         Header.astro saved for a reload/back-forward; a fresh visit starts at the
         top, expanded. Header.astro reconciles with the real scroll after load. -->
    <script is:inline>
      (function () {
        try {
          var nav = performance.getEntriesByType("navigation")[0];
          var t = nav && nav.type;
          if ((t === "reload" || t === "back_forward") && sessionStorage.getItem("sat-header-compact:" + location.pathname) === "1") {
            document.documentElement.classList.add("header-compact");
          }
        } catch (e) {}
      })();
    </script>
    <title>{title} · Swiss Association of Taiwan</title>
  </head>
  <body class="overflow-x-hidden">
    <Header current={current} />
    <slot />
    <Footer />
    <!-- EmailOctopus signup form (handoff/CHANGES-2026-09-23.md). It is a slide-in
         popup ("Get SAT Event Notifications"), not a section of the page, and its
         script drags in reCAPTCHA (~345 KiB of JS, three times over) and a Google
         Fonts stylesheet — the heaviest thing on the page by far. So nothing loads
         until the visitor first interacts (scroll, touch, click, key), with a 30 s
         fallback for someone who just reads. One script, one form, one reCAPTCHA.
         Appended to the end of <body>, where the static tag sat, with the
         data-form attribute the script looks for. -->
    <script is:inline>
      (function () {
        var loaded = false;
        var events = ["pointerdown", "keydown", "touchstart", "scroll"];
        function add() {
          if (loaded) return;
          loaded = true;
          for (var i = 0; i < events.length; i++) window.removeEventListener(events[i], add);
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://eocampaign1.com/form/564a6662-2f1f-11f1-b9df-0b322fe22b99.js";
          s.setAttribute("data-form", "564a6662-2f1f-11f1-b9df-0b322fe22b99");
          document.body.appendChild(s);
        }
        for (var i = 0; i < events.length; i++) window.addEventListener(events[i], add, { passive: true });
        setTimeout(add, 30000);
      })();
    </script>
  </body>
</html>
