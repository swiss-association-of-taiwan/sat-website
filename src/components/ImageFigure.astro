---
import { variantSrcset } from "../lib/responsive";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  ratio?: "21:9" | "3:2" | "1:1";
  grayscale?: boolean;
  class?: string;
  lightboxGroup?: string;
  lightboxIndex?: number;
  enlargeLabel?: string;
  objectPosition?: string;
  /** The `sizes` attribute — how wide the image renders at each breakpoint. Only
      used when AVIF/WebP variants exist in public/images/r/ (scripts/responsive-images.mjs). */
  sizes?: string;
  /** Above the fold: not lazy, fetched first. */
  priority?: boolean;
}

const {
  src,
  alt,
  caption,
  ratio = "3:2",
  grayscale = false,
  class: className,
  lightboxGroup,
  lightboxIndex,
  enlargeLabel,
  objectPosition,
  sizes = "100vw",
  priority = false,
} = Astro.props;

const ratioClass = { "21:9": "aspect-[21/9]", "3:2": "aspect-[3/2]", "1:1": "aspect-square" }[ratio];
// bg-canvas-soft + transparent text: the box is a neutral block, not a white
// hole with alt text in it, until the image arrives.
const imgClass = ["w-full h-full object-cover bg-canvas-soft text-[transparent]", ratioClass, grayscale && "grayscale"];
const imgStyle = objectPosition ? `object-position: ${objectPosition}` : undefined;
// src arrives already through withBase(); variantSrcset() reads the file name from it.
const avif = variantSrcset(src, "avif");
const webp = variantSrcset(src, "webp");
const loadingAttrs = priority ? { fetchpriority: "high", decoding: "async" } : { loading: "lazy", decoding: "async" };
---

<figure class:list={["m-0", className]}>
  {
    lightboxGroup ? (
      <button
        type="button"
        class="block w-full p-0 border border-ink bg-canvas-soft cursor-zoom-in"
        aria-label={enlargeLabel ?? `Enlarge: ${alt}`}
        data-lightbox-trigger={lightboxGroup}
        data-lightbox-index={lightboxIndex}
      >
        {webp ? (
          <picture class="contents">
            <source type="image/avif" srcset={avif} sizes={sizes} />
            <source type="image/webp" srcset={webp} sizes={sizes} />
            <img src={src} alt={alt} class:list={imgClass} style={imgStyle} {...loadingAttrs} />
          </picture>
        ) : (
          <img src={src} alt={alt} class:list={imgClass} style={imgStyle} />
        )}
      </button>
    ) : (
      webp ? (
        <picture class="contents">
          <source type="image/avif" srcset={avif} sizes={sizes} />
          <source type="image/webp" srcset={webp} sizes={sizes} />
          <img src={src} alt={alt} class:list={imgClass} style={imgStyle} {...loadingAttrs} />
        </picture>
      ) : (
        <img src={src} alt={alt} class:list={imgClass} style={imgStyle} />
      )
    )
  }
  {caption && <figcaption class="text-caption text-body border-t border-rule mt-sm pt-sm">{caption}</figcaption>}
</figure>
