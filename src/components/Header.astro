---
import { navLinks, type NavKey } from "../lib/nav";
import { withBase } from "../lib/url";

interface Props {
  current: NavKey;
}

const { current } = Astro.props;
---

{/*
  The header is position:fixed so its size never affects page layout; this slot
  holds the full-size header's height in the flow instead. A sticky header that
  shrinks pulls the content up, the browser's scroll anchoring moves scrollY
  with it, and the header flips straight back — the jitter loop at ~180px.
  Slot height = logo (150px, 74px on mobile) + the bar's padding + border.
*/}
<div id="header-slot" class="h-[calc(150px+2*var(--spacing-md)+1px)] max-[700px]:h-[calc(74px+2*var(--spacing-md)+1px)]">
<header id="site-header" class="fixed top-0 inset-x-0 z-50 bg-canvas border-b border-ink">
  <div class="max-w-content mx-auto flex items-center justify-between gap-lg px-5 lg:px-16 py-md">
    <a href={withBase("/")} class="shrink-0">
      <img
        id="brand-logo"
        src={withBase("/images/logo-v4.png")}
        alt="Swiss Association of Taiwan"
        width="500"
        height="364"
        class="h-[150px] max-[700px]:h-[74px] w-auto"
      />
      <img
        id="brand-mark"
        src={withBase("/images/sat-association-mark.svg")}
        alt="Swiss Association of Taiwan"
        width="469"
        height="90"
        class="h-[52px] w-auto"
      />
    </a>

    <nav aria-label="Primary" class="hidden min-[1120px]:flex items-center gap-[22px] ml-auto">
      {
        navLinks.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={link.key === current ? "page" : undefined}
            class:list={[
              "text-body-sm text-ink whitespace-nowrap pb-1 border-b-2 hover:text-red-ink",
              link.key === current ? "border-red" : "border-transparent",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={withBase("/membership/")}
      class="hidden min-[1120px]:inline-flex items-center shrink-0 bg-red text-on-red text-label px-lg py-md min-h-11 whitespace-nowrap hover:bg-red-ink"
    >
      Join SAT
    </a>

    <button
      id="nav-burger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      class="min-[1120px]:hidden flex flex-col justify-center items-center gap-[5px] w-11 h-11 ml-auto border-0 bg-transparent cursor-pointer"
    >
      <span class="block w-6 h-px bg-ink"></span>
      <span class="block w-6 h-px bg-ink"></span>
      <span class="block w-6 h-px bg-ink"></span>
    </button>
  </div>

  <div
    id="mobile-nav-panel"
    class="hidden min-[1120px]:!hidden fixed inset-0 top-[var(--header-h,0px)] z-40 bg-canvas overflow-y-auto"
  >
    <nav aria-label="Primary" class="flex flex-col">
      {
        navLinks.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={link.key === current ? "page" : undefined}
            class:list={[
              "text-body-md px-5 py-lg border-t border-rule first:border-t-0",
              link.key === current ? "text-red-ink" : "text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href={withBase("/membership/")} class="text-body-md px-5 py-lg border-t border-rule text-red-ink">
        Join SAT
      </a>
    </nav>
  </div>
</header>
</div>

<style is:global>
  /* Which logo shows follows html.header-compact, which the inline script in
     Layout.astro sets before first paint — no flash of the wrong state. */
  html.header-compact #brand-logo,
  html:not(.header-compact) #brand-mark {
    display: none;
  }
</style>

<script>
  const header = document.getElementById("site-header") as HTMLElement;
  const burger = document.getElementById("nav-burger") as HTMLButtonElement;
  const panel = document.getElementById("mobile-nav-panel") as HTMLElement;

  const setHeaderHeight = () => {
    header.style.setProperty("--header-h", `${header.offsetHeight}px`);
  };
  setHeaderHeight();
  window.addEventListener("resize", setHeaderHeight);

  // Past the scroll threshold the full lockup swaps for the association mark
  // (cross + roof, no wording) — SAT-DESIGN.md's three-form logo table — rather
  // than shrinking the lockup. See AGENTS.md "Three logo forms".
  //
  // Hysteresis: compact above 180px, back to large only below 80px, so a
  // scrollY hovering near one value can't flip it back and forth. Runs at most
  // once per frame.
  const root = document.documentElement;
  const storageKey = `sat-header-compact:${location.pathname}`;
  let compact = root.classList.contains("header-compact");
  let queued = false;

  const update = () => {
    queued = false;
    const y = window.scrollY;
    const next = compact ? y >= 80 : y > 180;
    if (next === compact) return;
    compact = next;
    root.classList.toggle("header-compact", compact);
    try {
      sessionStorage.setItem(storageKey, compact ? "1" : "0");
    } catch {}
    setHeaderHeight();
  };
  window.addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  // Reconcile once the browser has restored a reload's scroll position — not
  // earlier: scrollY is still 0 then and would undo the state set before paint.
  window.addEventListener("load", () => requestAnimationFrame(update));

  const closePanel = () => {
    panel.classList.add("hidden");
    burger.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };
  const openPanel = () => {
    panel.classList.remove("hidden");
    burger.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  burger.addEventListener("click", () => {
    const isOpen = burger.getAttribute("aria-expanded") === "true";
    isOpen ? closePanel() : openPanel();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && burger.getAttribute("aria-expanded") === "true") {
      closePanel();
      burger.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1120) closePanel();
  });
</script>
