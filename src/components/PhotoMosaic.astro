---
import { buildMosaic, tileSpanClass } from "../lib/photoMosaic";
import { withBase } from "../lib/url";

const tiles = buildMosaic();
---

{/* Occasion filter bar removed 2026-10-15 at JP's request: the wall is one
    mixed mosaic again. Occasion tags in impressions.json still drive the
    round-robin mix order, and getOccasionFilters() in lib/photoMosaic.ts is
    kept so the bar can be restored later. */}
<div class="border-t border-ink pt-5">
<div
  class="grid grid-cols-2 min-[560px]:grid-cols-4 md:grid-cols-6 gap-[6px] min-[560px]:gap-2 auto-rows-[clamp(88px,9.2vw,152px)]"
  style="grid-auto-flow: dense;"
  data-mosaic
>
  {
    tiles.map((tile, index) => (
      <button
        type="button"
        class:list={["relative block p-0 border-0 bg-canvas-soft overflow-hidden cursor-zoom-in group", tileSpanClass(tile.bandPosition)]}
        aria-label={`${tile.occasionLabel} — SAT`}
        data-occasion={tile.occasion}
        data-lightbox-trigger="impressions"
        data-lightbox-index={index}
      >
        <img
          src={withBase(`/impressions/${tile.filename}`)}
          alt={`${tile.occasionLabel} — SAT`}
          loading="lazy"
          class="w-full h-full object-cover text-[transparent] transition-transform duration-[350ms] ease-out group-hover:scale-[1.04] group-hover:opacity-[.88]"
        />
      </button>
    ))
  }
</div>
</div>

<script define:vars={{ images: tiles.map((t) => ({ src: withBase(`/impressions/${t.filename}`), alt: `${t.occasionLabel} — SAT` })) }}>
  window.__lightboxGroups = window.__lightboxGroups || {};
  window.__lightboxGroups.impressions = images;
</script>
