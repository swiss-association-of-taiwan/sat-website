---
import { navLinks } from "../lib/nav";
import { socialLinks } from "../data/social";
import { withBase } from "../lib/url";
---

<footer class="bg-ink text-on-dark">
  <div class="max-w-content mx-auto px-5 lg:px-16 pt-16 md:pt-24 pb-10">
    <div class="grid grid-cols-1 min-[641px]:grid-cols-2 min-[1025px]:grid-cols-3 gap-x-lg gap-y-2xl">
      <div>
        <img src={withBase("/images/sat-lockup-white.svg")} alt="Swiss Association of Taiwan" width="469" height="340" class="w-full max-w-[240px] h-auto" />
        <div class="text-body-sm text-on-dark mt-lg">Taipei, Taiwan</div>
      </div>

      <div class="flex flex-col gap-sm">
        {
          navLinks.map((link) => (
            <a href={withBase(link.href)} class="text-body-sm text-on-dark hover:underline">
              {link.label}
            </a>
          ))
        }
      </div>

      <div
        class:list={[
          "border-t border-on-dark pt-lg col-span-full",
          "min-[1025px]:border-t-0 min-[1025px]:pt-0 min-[1025px]:border-l min-[1025px]:pl-xl min-[1025px]:col-span-1",
        ]}
      >
        <p class="text-display-quiet text-on-dark max-w-[14ch]">Different backgrounds. A shared connection.</p>
      </div>
    </div>

    <div class="flex flex-wrap gap-x-8 gap-y-2 mt-[56px]">
      {
        socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-[10px] min-h-11 text-body-sm text-on-dark hover:underline"
          >
            <span class="shrink-0" set:html={social.markup} />
            {social.label}
          </a>
        ))
      }
    </div>

    <div class="mt-16 pt-lg border-t border-on-dark">
      <div class="text-caption text-on-dark">Swiss Association of Taiwan. A non-registered association, founded 1990.</div>
    </div>
  </div>
</footer>
