---
import Section from "./Section.astro";

interface Props {
  title: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  padY?: string;
}

const { title, body, primaryLabel, primaryHref, secondaryLabel, secondaryHref, padY } = Astro.props;
---

<Section background="canvas-soft" borderTop padY={padY}>
  <h2 class="text-heading-lg text-ink max-w-[26ch]">{title}</h2>
  <p class="text-body-lead text-body mt-lg max-w-[68ch]">{body}</p>
  <div class="flex flex-wrap gap-md mt-10">
    <a href={primaryHref} class="inline-flex items-center bg-red text-on-red text-label px-lg py-md min-h-11 hover:bg-red-ink">
      {primaryLabel}
    </a>
    {
      secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="inline-flex items-center bg-canvas-soft text-ink border border-ink text-label px-lg py-md min-h-11 hover:bg-ink hover:text-on-dark"
        >
          {secondaryLabel}
        </a>
      )
    }
  </div>
</Section>
