# Cloudflare static-assets headers (copied to dist/ as-is).
#
# /_astro/* is content-hashed by the build (fonts, CSS, JS), so a URL never
# changes its bytes: cache for a year, never revalidate.
#
# The image/PDF folders are NOT hashed — a file is replaced under the same
# name (favicon, logo marks and the email-signature lockup have all been
# swapped this way). "immutable" there would leave returning visitors on the
# old copy for a year, so they get a day, then serve-stale-while-revalidate.
# Moving between pages within a visit still re-downloads nothing.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/impressions/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/committee/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/docs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
